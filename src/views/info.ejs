<!DOCTYPE html>
<html lang="hr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= id %></title>
  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <main class="container">
    <h1>Digitalna propusnica <%= id %></h1>

    <section class="info">
      <p>Ime i prezime: <strong><%= name %></strong></p>
      <p>Dokument: <strong><%= document %></strong></p>
      <p>Vrijeme izdavanja: <strong><%= issuedAt.toLocaleString("hr-HR", { timeZone: "Europe/Zagreb" }) %></strong></p>
      <p>Status: <strong><%= status %></strong></p>
    </section>
  </main>
</body>

</html>